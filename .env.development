# Firebase web config for Lacus accounts (project lacus-app-509713). These values are public by
# design (they ship in every web page that uses Firebase) and are not secrets: the browser key is
# restricted to the two login APIs and to Lacus's own domains. Only the dev server reads this
# file, so the live site keeps showing Account as "Coming soon" until accounts are released.
VITE_FIREBASE_API_KEY=AIzaSyDd-_PW3OMNs1em7m8zTqpwwa0ADpVlDfU
VITE_FIREBASE_AUTH_DOMAIN=lacus-app-509713.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lacus-app-509713
VITE_FIREBASE_APP_ID=1:257820745059:web:2ae706c296bc88589cc756
# Sign-in providers that are switched on in Firebase (Authentication > Sign-in method), in any
# order: google.com, apple.com. Add one only after enabling it there.
VITE_AUTH_PROVIDERS=google.com,apple.com
