# Production data host: per-lake packages are served from the Cloud Storage bucket (public,
# CORS-enabled) instead of being bundled with the site. Public URL, not a secret. See
# src/timetable/client.ts (VITE_DATA_BASE_URL). Dev leaves this unset and uses /data.
VITE_DATA_BASE_URL=https://storage.googleapis.com/lacus-data/
